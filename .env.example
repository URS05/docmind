# Application Settings
TITLE="🚀 RAG with txtai"

# Lightweight LLM for fast CPU performance
LLM="Qwen/Qwen2.5-0.5B-Instruct"

# Set prebuilt HuggingFace index (e.g. neuml/txtai-wikipedia-slim) or leave empty for local custom index
EMBEDDINGS=""

# Context size (number of chunks retrieved per query)
CONTEXT=10

# Maximum response generation length
MAXLENGTH=2048

# Option to strip thinking tags
STRIPTHINK="false"

# Optional persistent directory to save added indexed documents
# PERSIST="./data/embeddings"
